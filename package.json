{
  "name": "dailyearly-whatsapp-status",
  "version": "1.0.0",
  "description": "Automated WhatsApp Status bot for year progress",
  "main": "src/upload.js",
  "scripts": {
    "post": "node src/upload.js",
    "post:now": "node src/upload.js --now",
