    "canvas": "^3.2.3",
    "node-schedule-tz": "^1.2.1-4",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "protobufjs@7.6.5": true,
    "sharp@0.35.4": true,
    "canvas@3.2.3": true
  }
}
